# Copy to srirail-frontend/.env.local; never commit real credentials.
SUPABASE_URL=https://your-project.supabase.co
# Publishable key (or legacy anon key), NEVER service_role / sb_secret.
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
# Exact application origin; no trailing path. Set to HTTPS deployment URL on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
